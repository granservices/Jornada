{
  "name": "neo-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo do Neo, plataforma operacional mobile-first da GranServices.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run prisma:generate",
    "infra:up": "powershell -ExecutionPolicy Bypass -File ./scripts/start-local-infra.ps1",
    "dev:doctor": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-doctor.ps1",
    "dev": "powershell -ExecutionPolicy Bypass -File ./scripts/start-local-dev.ps1",
    "test:local-dev": "powershell -ExecutionPolicy Bypass -File ./scripts/test-start-local-dev.ps1",
    "dev:api": "npm run start:dev --workspace @jornada/api",
    "dev:neo": "npm run dev --workspace @neo/neo",
    "dev:jornada": "npm run dev:neo",
    "build:api": "npm run build --workspace @jornada/api",
    "build:neo": "npm run build --workspace @neo/neo",
    "build:jornada": "npm run build:neo",
    "check": "npm run test:neo:guards && npm run build:api && npm run build:neo && npm run test:api && npm run test:neo",
    "lint:api": "npm run lint --workspace @jornada/api",
    "test:neo": "npm run test --workspace @neo/neo",
    "test:jornada": "npm run test:neo",
    "test:neo:guards": "npm run test:guards --workspace @neo/neo",
    "test:jornada:guards": "npm run test:neo:guards",
    "test:api": "npm run test --workspace @jornada/api",
    "test:api:cov": "npm run test:cov --workspace @jornada/api",
    "test:api:e2e": "npm run test:e2e --workspace @jornada/api",
    "prisma:generate": "npm run prisma:generate --workspace @jornada/api",
    "prisma:migrate:dev": "npm run prisma:migrate:dev --workspace @jornada/api"
  }
}
