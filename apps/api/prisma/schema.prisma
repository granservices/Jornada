generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  DISABLED
}

enum ApplicationStatus {
  ACTIVE
  INACTIVE
}

enum ApplicationEntryKind {
  NATIVE
  REDIRECT
}

enum UserApplicationAccessStatus {
  ACTIVE
  REVOKED
}

enum ApplicationRoleCode {
  USER
  AGENT
  MANAGER
  ADMIN
  MEMBER
  REQUESTER
  VIEWER
  AUTHOR
  PUBLISHER
}

enum AccessChangeReason {
  ONBOARDING
  ROLE_CHANGE
  SECURITY
  OFFBOARDING
  ACCESS_CORRECTION
  OTHER
}

enum UserApplicationRoleStatus {
  ACTIVE
  REVOKED
}

enum Role {
  EMPLOYEE
  ADMIN
  SUPPORT
  TI
  MEDICINE
  OPERATIONS
}

enum AuthAuditEventType {
  REGISTER
  LOGIN
  REFRESH
  LOGOUT
  FORGOT_PASSWORD
  RESET_PASSWORD
  SSO_TICKET_ISSUED
  SSO_TICKET_CONSUMED
}

enum AuthAuditOutcome {
  SUCCESS
  FAILURE
}

enum IntegrationInboxStatus {
  RECEIVED
  QUEUED
  PROCESSING
  PROCESSED
  FAILED
  DUPLICATE
}

enum DomainEventOutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum ChatSector {
  OPERATIONS
  MEDICINE
  TRAINING
  TI
  SUPPORT
}

enum ChatConversationStatus {
  OPEN
  ARCHIVED
}

enum ChatConversationKind {
  DIRECT
  TEAM
  SUPPORT
}

enum ChatParticipantType {
  USER
  TEAM
  SECTOR
  EXTERNAL
}

enum ChatParticipantRole {
  REQUESTER
  MEMBER
  AGENT
  OBSERVER
}

enum ChatMessageSenderType {
  USER
  TEAM
  SECTOR
  SYSTEM
  EXTERNAL
}

enum SupportTeamStatus {
  ACTIVE
  INACTIVE
}

enum SupportCatalogStatus {
  ACTIVE
  DRAFT
  INACTIVE
}

enum SupportCaseOpeningPolicy {
  CONTINUOUS_CONVERSATION
  INDIVIDUAL_REQUEST
  BUSINESS_KEY
}

enum SupportFormFieldType {
  TEXT
  TEXTAREA
  SELECT
  DATE
  BOOLEAN
  NUMBER
  FILE
}

enum FormOwnerType {
  GLOBAL
  SUPPORT_DEPARTMENT
}

enum FormRequestStatus {
  PENDING
  SUBMITTED
  EXPIRED
  CANCELLED
}

enum OptionSourceAdapterType {
  STATIC
  HTTP_JSON
}

enum OptionSourceStatus {
  ACTIVE
  INACTIVE
}

enum SupportTriageSuggestionSource {
  RULE
  LOCAL_AI
  EXTERNAL_AI
}

enum SupportIntegrationProvider {
  INTERNAL
  MICROSOFT_TEAMS
  EMAIL
  WHATSAPP
}

enum SupportCaseStatus {
  NEW
  OPEN
  WAITING_REQUESTER
  WAITING_INTERNAL
  WAITING_APPROVAL
  RESOLVED
  CLOSED
}

enum SupportCasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportCaseOrigin {
  CHAT
  MANUAL
  INTEGRATION
}

enum SupportCaseEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  TRANSFERRED
  COMMENTED
  LINKED_MESSAGE
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  APPROVAL_CHANGES_REQUESTED
  APPROVAL_CANCELLED
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  CANCELLED
  EXPIRED
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  CANCELLED
  EXPIRED
}

enum ApprovalEventType {
  REQUESTED
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  RESUBMITTED
  CANCELLED
  EXPIRED
  COMMENTED
}

enum SupportResponsibilityOwnerType {
  SUPPORT_TEAM
  REQUESTER
  APPROVAL_TEAM
  EXTERNAL
}

enum AuditAction {
  READ
  CREATE
  UPDATE
  DELETE
  SOFT_DELETE
  PUBLISH
  SAVE_DRAFT
  LINK
  UNLINK
}

model User {
  id                String               @id @default(cuid())
  email             String               @unique
  personId          String               @unique
  passwordHash      String?
  status            UserStatus           @default(ACTIVE)
  roles             Role[]               @default([EMPLOYEE])
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  person            Person               @relation(fields: [personId], references: [id])
  sessions          AuthSession[]
  ssoTickets        AuthSsoTicket[]
  passwordResetLogs PasswordResetToken[]
  administrativeInvitations AdministrativeInvitation[] @relation("AdministrativeInvitationUser")
  createdAdministrativeInvitations AdministrativeInvitation[] @relation("AdministrativeInvitationCreator")
  authAuditLogs     AuthAuditLog[]
  chatConversations ChatConversation[]
  chatMessages      ChatMessage[]
  chatParticipants  ChatParticipant[]
  chatReadStates    ChatReadState[]
  requestedSupportCases SupportCase[]       @relation("SupportCaseRequester")
  assignedSupportCases  SupportCase[]       @relation("SupportCaseAssignee")
  supportCaseEvents     SupportCaseEvent[]  @relation("SupportCaseEventAuthor")
  requestedApprovalRequests ApprovalRequest[] @relation("ApprovalRequestRequester")
  approvalEvents        ApprovalEvent[]     @relation("ApprovalEventAuthor")
  decidedApprovalSteps  ApprovalStep[]      @relation("ApprovalStepDecider")
  supportRatings        SupportRating[]     @relation("SupportRatingReviewer")
  supportTeamMemberships SupportTeamMember[]
  auditLogs             AuditLog[]          @relation("AuditLogActor")
  applicationAccesses   UserApplicationAccess[]
  applicationRoles      UserApplicationRole[]
  requestedFormRequests FormRequest[]        @relation("FormRequestRequester")
  respondentFormRequests FormRequest[]       @relation("FormRequestRespondent")
  submittedFormResponses FormResponse[]      @relation("FormResponseSubmitter")
  profilePreference     UserProfilePreference?
}

enum UserProfileNotificationChannel {
  EMAIL
  PHONE
  WHATSAPP
  NONE
}

model UserProfilePreference {
  id                    String                         @id @default(cuid())
  userId                String                         @unique
  preferredName         String?
  phoneNumber           String?
  emergencyContactName  String?
  emergencyContactPhone String?
  primaryBase           String?
  notificationChannel   UserProfileNotificationChannel @default(EMAIL)
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  user                  User                           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([notificationChannel])
}

model Application {
  id          String                      @id @default(cuid())
  code        String                      @unique
  name        String
  description String?
  entryKind   ApplicationEntryKind        @default(NATIVE)
  entryPath   String
  imageUrl    String?
  sortOrder   Int                         @default(0)
  status      ApplicationStatus           @default(ACTIVE)
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  accesses    UserApplicationAccess[]
  roles       UserApplicationRole[]
  ssoTickets  AuthSsoTicket[]

  @@index([status, sortOrder, name])
}

model UserApplicationAccess {
  id            String                      @id @default(cuid())
  userId        String
  applicationId String
  status        UserApplicationAccessStatus @default(ACTIVE)
  isDefault     Boolean                     @default(false)
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  user          User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application                 @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([userId, applicationId])
  @@index([userId, status])
  @@index([applicationId, status])
}

model UserApplicationRole {
  id            String                    @id @default(cuid())
  userId        String
  applicationId String
  roleCode      ApplicationRoleCode
  status        UserApplicationRoleStatus @default(ACTIVE)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application               @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([userId, applicationId, roleCode])
  @@index([userId, applicationId, status])
  @@index([applicationId, roleCode, status])
}

model AuditLog {
  id          String      @id @default(cuid())
  actorUserId String?
  action      AuditAction
  entityType  String
  entityId    String?
  entityLabel String?
  before      Json?
  after       Json?
  metadata    Json?
  requestId   String?
  createdAt   DateTime    @default(now())
  actor       User?       @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@index([requestId])
}

model SupportTeam {
  id             String                    @id @default(cuid())
  departmentId   String?
  code           String                    @unique
  name           String
  status         SupportTeamStatus         @default(ACTIVE)
  notificationProvider SupportIntegrationProvider?
  notificationRef String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  primaryConversations ChatConversation[]  @relation("ChatConversationPrimaryTeam")
  participants   ChatParticipant[]
  sentMessages   ChatMessage[]
  supportCases   SupportCase[]             @relation("SupportCaseCurrentTeam")
  approvalRules  ApprovalRule[]            @relation("ApprovalRuleTeam")
  approvalSteps  ApprovalStep[]            @relation("ApprovalStepTeam")
  responsibilityPeriods SupportResponsibilityPeriod[] @relation("ResponsibilityPeriodTeam")
  department      SupportDepartment?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  routingRules    SupportRoutingRule[]
  members         SupportTeamMember[]

  @@index([departmentId, status, name])
  @@index([status, name])
  @@index([notificationProvider, notificationRef])
}

model SupportDepartment {
  id          String               @id @default(cuid())
  code        String               @unique
  name        String
  description String?
  status      SupportCatalogStatus @default(ACTIVE)
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  teams       SupportTeam[]
  topics      SupportTopic[]
  forms       FormDefinition[]     @relation("SupportDepartmentForms")
  routingRules SupportRoutingRule[]
  approvalRules ApprovalRule[]
  supportCases SupportCase[]

  @@index([status, sortOrder, name])
}

model FormRequest {
  id                String            @id @default(cuid())
  formId            String
  requestedByUserId String
  respondentUserId  String
  sourceApplication String
  sourceContextType String
  sourceContextId   String
  dueAt             DateTime?
  status            FormRequestStatus @default(PENDING)
  submittedAt       DateTime?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  form              FormDefinition    @relation(fields: [formId], references: [id], onDelete: Restrict)
  requestedBy       User              @relation("FormRequestRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  respondent        User              @relation("FormRequestRespondent", fields: [respondentUserId], references: [id], onDelete: Restrict)
  response          FormResponse?

  @@index([respondentUserId, status, dueAt])
  @@index([sourceApplication, sourceContextType, sourceContextId])
  @@index([formId, status])
}

model FormResponse {
  id                String      @id @default(cuid())
  formRequestId     String      @unique
  submittedByUserId String
  values            Json
  submittedAt       DateTime    @default(now())
  formRequest       FormRequest @relation(fields: [formRequestId], references: [id], onDelete: Cascade)
  submittedBy       User        @relation("FormResponseSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
}

model SupportTopic {
  id           String               @id @default(cuid())
  departmentId String
  code         String
  name         String
  description  String?
  status       SupportCatalogStatus @default(ACTIVE)
  defaultPriority SupportCasePriority @default(NORMAL)
  openingPolicy SupportCaseOpeningPolicy @default(CONTINUOUS_CONVERSATION)
  businessKeyFieldCode String?
  sortOrder    Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  department   SupportDepartment    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  routingRules SupportRoutingRule[]
  approvalRules ApprovalRule[]
  legacyForms  FormDefinition[]     @relation("LegacySupportTopicForms")
  formBindings SupportTopicFormBinding[]
  supportCases SupportCase[]

  @@unique([departmentId, code])
  @@index([departmentId, status, sortOrder, name])
}

model SupportRoutingRule {
  id           String               @id @default(cuid())
  departmentId String
  topicId      String?
  teamId       String
  status       SupportCatalogStatus @default(ACTIVE)
  priority     Int                  @default(100)
  conditions   Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  department   SupportDepartment    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  topic        SupportTopic?        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  team         SupportTeam          @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([departmentId, topicId, status, priority])
  @@index([teamId, status])
}

model SupportTeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      ChatParticipantRole @default(AGENT)
  status    SupportCatalogStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      SupportTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId, status])
  @@index([teamId, status])
}

model FormDefinition {
  id          String               @id @default(cuid())
  topicId     String?
  ownerType   FormOwnerType        @default(SUPPORT_DEPARTMENT)
  ownerDepartmentId String?
  key         String?
  version     Int
  status      SupportCatalogStatus @default(ACTIVE)
  title       String
  description String?
  schema      Json?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  topic       SupportTopic?        @relation("LegacySupportTopicForms", fields: [topicId], references: [id], onDelete: SetNull)
  ownerDepartment SupportDepartment? @relation("SupportDepartmentForms", fields: [ownerDepartmentId], references: [id], onDelete: SetNull)
  fields      FormField[]
  supportTopicBindings SupportTopicFormBinding[]
  supportCases SupportCase[]
  approvalRules ApprovalRule[]
  requests     FormRequest[]

  @@unique([topicId, version])
  @@index([ownerType, ownerDepartmentId, status])
  @@index([topicId, status, version])
  @@map("SupportTopicForm")
}

model FormField {
  id          String               @id @default(cuid())
  formId      String
  code        String
  label       String
  fieldType   SupportFormFieldType
  required    Boolean              @default(false)
  sensitive   Boolean              @default(false)
  helpText    String?
  options     Json?
  optionSourceKey String?
  visibleWhen Json?
  requiredWhen Json?
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  form        FormDefinition       @relation(fields: [formId], references: [id], onDelete: Cascade)
  optionSource OptionSource?       @relation(fields: [optionSourceKey], references: [key], onDelete: Restrict)
  values      SupportCaseFieldValue[]

  @@unique([formId, code])
  @@index([formId, sortOrder])
  @@index([optionSourceKey])
  @@map("SupportTopicField")
}

model OptionSource {
  id              String                  @id @default(cuid())
  key             String                  @unique
  name            String
  adapterType     OptionSourceAdapterType
  status          OptionSourceStatus      @default(ACTIVE)
  config          Json
  cacheTtlSeconds Int                     @default(300)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  fields          FormField[]

  @@index([status, name])
  @@index([adapterType, status])
}

model SupportTopicFormBinding {
  id        String               @id @default(cuid())
  topicId   String
  formId    String
  status    SupportCatalogStatus @default(ACTIVE)
  isPrimary Boolean              @default(false)
  required  Boolean              @default(true)
  sortOrder Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  topic     SupportTopic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  form      FormDefinition       @relation(fields: [formId], references: [id], onDelete: Restrict)

  @@unique([topicId, formId])
  @@index([topicId, status, sortOrder])
  @@index([formId, status])
}

model Person {
  id          String    @id @default(cuid())
  fullName    String
  cpf         String?   @unique
  birthDate   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User?
  employee    Employee?
}

model Employee {
  id                String    @id @default(cuid())
  personId          String    @unique
  employeeNumber    String?   @unique
  externalEmployeeId String?  @unique
  department        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  person            Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthSsoTicket {
  id            String      @id @default(cuid())
  userId        String
  applicationId String
  tokenHash     String      @unique
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AdministrativeInvitation {
  id              String             @id @default(cuid())
  userId          String
  createdByUserId String
  tokenHash       String             @unique
  reason          AccessChangeReason
  reasonComment   String?
  expiresAt       DateTime
  consumedAt      DateTime?
  invalidatedAt   DateTime?
  createdAt       DateTime           @default(now())
  user            User               @relation("AdministrativeInvitationUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy       User               @relation("AdministrativeInvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([createdByUserId, createdAt])
  @@index([expiresAt])
}

model AuthAuditLog {
  id          String           @id @default(cuid())
  userId      String?
  email       String?
  eventType   AuthAuditEventType
  outcome     AuthAuditOutcome
  requestId   String?
  ipAddress   String?
  userAgent   String?
  reason      String?
  createdAt   DateTime         @default(now())
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType, createdAt])
  @@index([requestId])
}

model DrakeWebhookInboxEvent {
  id                 String                 @id @default(cuid())
  webhookType        String
  requestId          String?
  correlationId      String
  idempotencyKey     String                 @unique
  eventName          String?
  externalEventId    String?
  employeeId         String?
  status             IntegrationInboxStatus @default(RECEIVED)
  payload            Json
  metadata           Json
  storagePath        String?
  processingAttempts Int                    @default(0)
  lastQueuedAt       DateTime?
  processingStartedAt DateTime?
  processedAt        DateTime?
  failedAt           DateTime?
  lastError          String?
  createdAt          DateTime               @default(now())

  @@index([webhookType, createdAt])
  @@index([correlationId])
  @@index([externalEventId])
  @@index([employeeId])
  @@index([status, createdAt])
}

model ChatConversation {
  id            String                 @id @default(cuid())
  employeeUserId String?
  sector        ChatSector?
  primaryTeamId String?
  kind          ChatConversationKind   @default(SUPPORT)
  title         String
  status        ChatConversationStatus @default(OPEN)
  lastMessageAt DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  employeeUser  User?                 @relation(fields: [employeeUserId], references: [id], onDelete: Cascade)
  primaryTeam   SupportTeam?          @relation("ChatConversationPrimaryTeam", fields: [primaryTeamId], references: [id], onDelete: SetNull)
  messages      ChatMessage[]
  participants  ChatParticipant[]
  readStates    ChatReadState[]
  integrationLinks SupportIntegrationLink[]
  originSupportCases SupportCase[]     @relation("SupportCaseOriginConversation")

  @@index([kind, status, updatedAt])
  @@index([primaryTeamId, status, updatedAt])
  @@index([employeeUserId, status, updatedAt])
  @@index([employeeUserId, sector, kind, status])
  @@index([sector, updatedAt])
}

model ChatParticipant {
  id              String              @id @default(cuid())
  conversationId  String
  participantType ChatParticipantType
  participantKey  String
  userId          String?
  teamId          String?
  sector          ChatSector?
  externalRef     String?
  role            ChatParticipantRole @default(MEMBER)
  joinedAt        DateTime            @default(now())
  leftAt          DateTime?
  mutedAt         DateTime?
  conversation    ChatConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  team            SupportTeam?        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([conversationId, participantKey])
  @@index([userId, leftAt])
  @@index([teamId, leftAt])
  @@index([sector, leftAt])
  @@index([participantType, participantKey])
}

model ChatMessage {
  id              String                @id @default(cuid())
  conversationId  String
  senderType      ChatMessageSenderType
  senderUserId    String?
  senderTeamId    String?
  senderSector    ChatSector?
  senderName      String
  body            String
  clientMessageId String?
  createdAt       DateTime              @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?
  conversation    ChatConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser      User?                 @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  senderTeam      SupportTeam?          @relation(fields: [senderTeamId], references: [id], onDelete: SetNull)
  originSupportCases SupportCase[]       @relation("SupportCaseOriginMessage")

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([senderUserId, createdAt])
}

model SupportCase {
  id                   String              @id @default(cuid())
  code                 String              @unique
  departmentId         String?
  topicId              String?
  topicFormId          String?
  title                String
  description          String?
  businessKey          String?
  status               SupportCaseStatus   @default(NEW)
  priority             SupportCasePriority @default(NORMAL)
  origin               SupportCaseOrigin   @default(CHAT)
  requesterUserId      String
  currentSector        ChatSector?
  currentTeamId        String?
  assignedUserId       String?
  originConversationId String?
  originMessageId      String?
  dueAt                DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  requester            User                @relation("SupportCaseRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  department           SupportDepartment?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  topic                SupportTopic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  topicForm            FormDefinition?     @relation(fields: [topicFormId], references: [id], onDelete: SetNull)
  currentTeam          SupportTeam?        @relation("SupportCaseCurrentTeam", fields: [currentTeamId], references: [id], onDelete: SetNull)
  assignedUser         User?               @relation("SupportCaseAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  originConversation   ChatConversation?   @relation("SupportCaseOriginConversation", fields: [originConversationId], references: [id], onDelete: SetNull)
  originMessage        ChatMessage?        @relation("SupportCaseOriginMessage", fields: [originMessageId], references: [id], onDelete: SetNull)
  events               SupportCaseEvent[]
  integrationLinks     SupportIntegrationLink[]
  rating               SupportRating?
  fieldValues          SupportCaseFieldValue[]
  triageSuggestions    SupportTriageSuggestion[]
  approvalRequests     ApprovalRequest[]
  responsibilityPeriods SupportResponsibilityPeriod[]

  @@index([departmentId, status, updatedAt])
  @@index([topicId, status, updatedAt])
  @@index([requesterUserId, status, updatedAt])
  @@index([requesterUserId, topicId, businessKey, status])
  @@index([currentTeamId, status, updatedAt])
  @@index([currentSector, status, updatedAt])
  @@index([assignedUserId, status, updatedAt])
  @@index([originConversationId])
}

model SupportSlaPolicy {
  id                    String              @id @default(cuid())
  priority              SupportCasePriority @unique
  resolutionTargetMinutes Int
  active                Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([active, priority])
}

model ApprovalRule {
  id                    String               @id @default(cuid())
  departmentId          String?
  topicId               String?
  formId                String?
  approvalTeamId        String
  status                SupportCatalogStatus @default(ACTIVE)
  priority              Int                  @default(100)
  conditions            Json?
  defaultDueMinutes     Int?
  manualTriggerAllowed  Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  department            SupportDepartment?   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  topic                 SupportTopic?        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  form                  FormDefinition?      @relation(fields: [formId], references: [id], onDelete: SetNull)
  approvalTeam          SupportTeam          @relation("ApprovalRuleTeam", fields: [approvalTeamId], references: [id], onDelete: Restrict)
  approvalRequests      ApprovalRequest[]

  @@index([departmentId, topicId, status, priority])
  @@index([formId, status, priority])
  @@index([approvalTeamId, status])
}

model ApprovalRequest {
  id                String                @id @default(cuid())
  supportCaseId     String
  ruleId            String?
  status            ApprovalRequestStatus @default(PENDING)
  requestedByUserId String?
  currentStepId     String?               @unique
  reason            String?
  dueAt             DateTime?
  decidedAt         DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  supportCase       SupportCase           @relation(fields: [supportCaseId], references: [id], onDelete: Cascade)
  rule              ApprovalRule?         @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  requestedBy       User?                 @relation("ApprovalRequestRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  currentStep       ApprovalStep?         @relation("ApprovalRequestCurrentStep", fields: [currentStepId], references: [id], onDelete: SetNull)
  steps             ApprovalStep[]        @relation("ApprovalRequestSteps")
  events            ApprovalEvent[]
  responsibilityPeriods SupportResponsibilityPeriod[]

  @@index([supportCaseId, status, updatedAt])
  @@index([status, dueAt])
  @@index([ruleId, status])
}

model ApprovalStep {
  id                String             @id @default(cuid())
  approvalRequestId String
  approvalTeamId    String
  stepOrder         Int                @default(1)
  status            ApprovalStepStatus @default(PENDING)
  dueAt             DateTime?
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionComment   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  approvalRequest   ApprovalRequest    @relation("ApprovalRequestSteps", fields: [approvalRequestId], references: [id], onDelete: Cascade)
  currentForRequest ApprovalRequest?   @relation("ApprovalRequestCurrentStep")
  approvalTeam      SupportTeam        @relation("ApprovalStepTeam", fields: [approvalTeamId], references: [id], onDelete: Restrict)
  decidedBy         User?              @relation("ApprovalStepDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  events            ApprovalEvent[]

  @@index([approvalTeamId, status, dueAt])
  @@index([approvalRequestId, stepOrder])
  @@index([decidedByUserId, decidedAt])
}

model ApprovalEvent {
  id                String            @id @default(cuid())
  approvalRequestId String
  approvalStepId    String?
  eventType         ApprovalEventType
  authorUserId      String?
  comment           String?
  metadata          Json?
  createdAt         DateTime          @default(now())
  approvalRequest   ApprovalRequest   @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  approvalStep      ApprovalStep?     @relation(fields: [approvalStepId], references: [id], onDelete: SetNull)
  authorUser        User?             @relation("ApprovalEventAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([approvalRequestId, createdAt])
  @@index([approvalStepId, createdAt])
  @@index([eventType, createdAt])
}

model SupportResponsibilityPeriod {
  id                String                         @id @default(cuid())
  supportCaseId     String
  ownerType         SupportResponsibilityOwnerType
  ownerTeamId       String?
  approvalRequestId String?
  startedAt         DateTime                       @default(now())
  endedAt           DateTime?
  reason            String?
  supportCase       SupportCase                    @relation(fields: [supportCaseId], references: [id], onDelete: Cascade)
  ownerTeam         SupportTeam?                   @relation("ResponsibilityPeriodTeam", fields: [ownerTeamId], references: [id], onDelete: SetNull)
  approvalRequest   ApprovalRequest?               @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)

  @@index([supportCaseId, startedAt])
  @@index([ownerTeamId, ownerType, endedAt])
  @@index([approvalRequestId])
}

model SupportCaseFieldValue {
  id            String            @id @default(cuid())
  supportCaseId String
  fieldId       String
  value         Json
  sensitive     Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  supportCase   SupportCase       @relation(fields: [supportCaseId], references: [id], onDelete: Cascade)
  field         FormField @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  @@unique([supportCaseId, fieldId])
  @@index([fieldId])
  @@index([supportCaseId])
}

model SupportTriageSuggestion {
  id               String                      @id @default(cuid())
  supportCaseId    String?
  requesterUserId  String?
  source           SupportTriageSuggestionSource
  inputHash        String
  suggestedDepartmentId String?
  suggestedTopicId String?
  suggestedTeamId  String?
  confidence       Float?
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  metadata         Json?
  createdAt        DateTime                    @default(now())
  supportCase      SupportCase?                @relation(fields: [supportCaseId], references: [id], onDelete: SetNull)

  @@index([requesterUserId, createdAt])
  @@index([source, createdAt])
  @@index([suggestedDepartmentId])
  @@index([suggestedTopicId])
  @@index([suggestedTeamId])
}

model SupportIntegrationLink {
  id              String                       @id @default(cuid())
  provider        SupportIntegrationProvider
  conversationId  String?
  supportCaseId   String?
  externalTenantId String?
  externalWorkspaceId String?
  externalChannelId String?
  externalReference String?
  externalUrl    String?
  purpose         String                       @default("NOTIFICATION")
  metadata        Json?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  conversation    ChatConversation?            @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  supportCase     SupportCase?                 @relation(fields: [supportCaseId], references: [id], onDelete: SetNull)

  @@unique([provider, externalReference])
  @@index([conversationId])
  @@index([supportCaseId])
  @@index([provider, purpose])
  @@index([provider, externalWorkspaceId, externalChannelId])
}

model SupportRating {
  id             String      @id @default(cuid())
  supportCaseId  String      @unique
  reviewerUserId String
  score          Int
  comment        String?
  metadata       Json?
  createdAt      DateTime    @default(now())
  supportCase    SupportCase @relation(fields: [supportCaseId], references: [id], onDelete: Cascade)
  reviewer       User        @relation("SupportRatingReviewer", fields: [reviewerUserId], references: [id], onDelete: Cascade)

  @@index([reviewerUserId, createdAt])
  @@index([score, createdAt])
}

model SupportCaseEvent {
  id            String               @id @default(cuid())
  supportCaseId String
  eventType     SupportCaseEventType
  authorUserId  String?
  fromValue     String?
  toValue       String?
  metadata      Json?
  createdAt     DateTime             @default(now())
  supportCase   SupportCase          @relation(fields: [supportCaseId], references: [id], onDelete: Cascade)
  authorUser    User?                @relation("SupportCaseEventAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([supportCaseId, createdAt])
  @@index([authorUserId, createdAt])
  @@index([eventType, createdAt])
}

model DomainEventOutbox {
  id             String                 @id @default(cuid())
  idempotencyKey String                 @unique
  eventType      String
  aggregateType  String
  aggregateId    String
  payload        Json
  correlationId  String?
  status         DomainEventOutboxStatus @default(PENDING)
  attempts       Int                    @default(0)
  availableAt    DateTime               @default(now())
  deliveredAt    DateTime?
  lastError      String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([eventType, createdAt])
  @@index([correlationId])
}

model ProcessedDomainEvent {
  id          String   @id @default(cuid())
  consumer    String
  eventId     String
  processedAt DateTime @default(now())

  @@unique([consumer, eventId])
  @@index([eventId])
}

model ChatReadState {
  id                String           @id @default(cuid())
  conversationId    String
  userId            String
  lastReadMessageId String?
  lastReadAt        DateTime         @default(now())
  conversation      ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}
