NODE_ENV=development
PORT=3004
DATABASE_URL=postgresql://jornada:jornada@localhost:55432/jornada?schema=public
REDIS_URL=redis://localhost:56379
LOG_LEVEL=info
DRAKE_WEBHOOK_BEARER_TOKEN=replace-with-a-strong-random-token
DRAKE_WEBHOOK_AUTH_DISABLED=false
DRAKE_API_BASE_URL=https://drake.bz/api
# Credenciais de leitura do Crew Rotation. Nunca expor no frontend.
DRAKE_TENANT_ID=
DRAKE_AUTH_TOKEN=
DRAKE_SCHEDULE_HTTP_TIMEOUT_MS=8000
JWT_ACCESS_SECRET=replace-with-a-strong-random-token
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-token
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=jornada-api
JWT_AUDIENCE=jornada-app
PASSWORD_RESET_EXPIRES_IN_MINUTES=30
JORNADA_PUBLIC_BASE_URL=http://localhost:3006
# Reutiliza o mesmo padrao SMTP do CrewControl para convites administrativos.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
AUTH_PUBLIC_REGISTRATION_ENABLED=false
AUTH_SSO_TICKET_EXPIRES_IN_SECONDS=60
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
AUTH_THROTTLE_TTL_MS=900000
AUTH_THROTTLE_LIMIT=5
WEBHOOK_STORAGE_DIR=./data/webhooks
SISPAT_IMPORT_STORAGE_DIR=./data/sispat-imports
FORM_OPTION_SOURCE_ALLOWED_HOSTS=api.example.com
FORM_OPTION_SOURCE_HTTP_TIMEOUT_MS=5000
DRAKE_WEBHOOK_QUEUE_ENABLED=true
DRAKE_WEBHOOK_QUEUE_ATTEMPTS=5
DRAKE_WEBHOOK_QUEUE_BACKOFF_MS=5000
DOMAIN_EVENT_QUEUE_ENABLED=true
DOMAIN_EVENT_QUEUE_ATTEMPTS=5
DOMAIN_EVENT_QUEUE_BACKOFF_MS=5000
DOMAIN_EVENT_RELAY_INTERVAL_MS=10000
DOMAIN_EVENT_PROCESSING_TIMEOUT_MS=300000
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=admin@granservices.com.br
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-admin-password
ADMIN_BOOTSTRAP_FULL_NAME=Administrador Jornada
